{% block 'container', class: 'os-stage w-full max-w-page mx-auto px-margin' %}
  {%- assign product_title = product.title -%}
  {%- if product_title == blank -%}
    {%- assign product_title = 'product.placeholder_title' | t -%}
  {%- endif -%}
  {%- # theme-check-disable-next-line UnknownFilter %}
  <s-view-event class="block pb-4" view-event-trigger="connect" view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
  {%- comment -%} Product Detail: 60/40 Split {%- endcomment -%}
  <div class="grid grid-cols-1 product-grid gap-6 md:gap-12 md:pt-8 mb-16">
    {%- comment -%} Left: Image Gallery (60%), drawn as the PREVIEW window from 48rem; phones keep the full-bleed strip. {%- endcomment -%}
    {% block 'frame', window: 'pane', class: 'os-fit min-w-0 md:self-start max-md:border-0 max-md:p-0 max-md:bg-transparent max-md:[&>.frame-inner]:border-0' %}
    <div class="panel-header os-pane-bar max-md:hidden">
      {% block 'text', tag: 'span', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'os.inspector_media' | t }}{% endblock %}
      <span class="os-page-meta truncate">{{ product_title | escape }}</span>
    </div>
    {%- comment -%}
      Variant-focused inspection viewport. Everything inside the 'product-media' partial is fetched
      by s-variant-picker.js on variant change, alongside product-form and product-title — keep the
      partial name stable on both sides.
    {%- endcomment -%}
    {% partial 'product-media' %}
    {%- liquid
      # Frame set for the selected variant, in priority order:
      # 1. the variant's custom.media file list, when it has images or videos;
      # 2. the variant's linked image first, then product media that is not another variant's linked image (shared shots);
      # 3. every product image, when step 2 leaves nothing.
      # The first frame always leads, so mirror this choice in snippets/lcp-preload.liquid.
      assign gallery_variant = product.selected_or_first_available_variant
      assign gallery_field_media = gallery_variant.metafields.custom.media.value
      assign gallery_from_field = false
      assign gallery_total = 0
      if gallery_field_media != blank
        for item in gallery_field_media
          if item.media_type == 'image' or item.media_type == 'video'
            assign gallery_total = gallery_total | plus: 1
          endif
        endfor
        if gallery_total > 0
          assign gallery_from_field = true
          assign gallery_items = gallery_field_media
        endif
      endif

      unless gallery_from_field
        assign other_variant_media_ids = ','
        for v in product.variants
          if v.featured_media and v.id != gallery_variant.id
            assign other_variant_media_ids = other_variant_media_ids | append: v.featured_media.id | append: ','
          endif
        endfor
        assign gallery_lead = ''
        assign gallery_rest = ''
        for media in product.media
          assign media_key = ',' | append: media.id | append: ','
          if gallery_variant.featured_media and media.id == gallery_variant.featured_media.id
            assign gallery_lead = forloop.index0 | append: ','
          elsif other_variant_media_ids contains media_key
            continue
          else
            assign gallery_rest = gallery_rest | append: forloop.index0 | append: ','
          endif
        endfor
        assign gallery_index_string = gallery_lead | append: gallery_rest
        if gallery_index_string == blank
          for media in product.media
            assign gallery_index_string = gallery_index_string | append: forloop.index0 | append: ','
          endfor
        endif
        assign gallery_items = gallery_index_string | split: ','
        assign gallery_total = gallery_items.size
      endunless

      assign gallery_total_label = gallery_total | prepend: '0' | slice: -2, 2
      assign viewport_id = 'media-viewport-' | append: product.id
      # The stage spans the full 2fr gallery column; lcp-preload mirrors this sizes value.
      assign gallery_sizes = '(min-width: 1280px) 768px, (min-width: 768px) calc((100vw - 128px) * 2 / 3), 100vw'
    -%}
    <s-product-image-zoom class="block">
      <s-media-viewport id="{{ viewport_id }}" class="block md:pb-4" data-start="0">
        {%- comment -%} Stage: a scroll-snap track (swipe on phones, full bleed) framed by HUD brackets. Native media controls own keyboard focus, so the track adds no tab stop of its own. {%- endcomment -%}
        <div class="hud-viewport mx-[calc(-1*var(--spacing-margin)-max(0px,(100vw-var(--spacing-page))/2))] w-[calc(100%+2*var(--spacing-margin)+max(0px,100vw-var(--spacing-page)))] border-y border-line-400 bg-panel md:mx-0 md:w-auto md:border">
          <s-inspect class="contents" data-label="{{ 'product.inspect_label' | t }}">
          <div
            data-viewport-track
            {% if gallery_total > 0 %}role="region" aria-label="{{ product_title | escape }}"{% endif %}
            class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain scrollbar-none [&::-webkit-scrollbar]:hidden md:mx-auto md:max-w-[max(16rem,calc(100dvh-var(--os-menubar-h,3rem)-var(--os-dock-space,5rem)-40px-12rem))]"
          >
            {% if gallery_total == 0 %}
              {% render 'placeholder-texture', kind: 'product', seed: 1, class: 'shrink-0 snap-center w-full aspect-square contain-paint', aria_label: product_title %}
            {% endif %}
            {%- assign frame_index = 0 -%}
            {% for item in gallery_items %}
              {%- liquid
                if gallery_from_field
                  assign media = item
                else
                  assign media_position = item | plus: 0
                  assign media = product.media[media_position]
                endif
                unless media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video'
                  continue
                endunless
              -%}
              <div class="shrink-0 snap-center snap-always w-full contain-paint" data-frame>
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign image_label = media.alt | default: media.preview_image.alt | default: product_title
                    assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
                  -%}
                  <div {% if frame_index == 0 %}style="view-transition-name: pimg-{{ product.id }}"{% endif %} data-inspect-src="{{ media | image_url: width: 2000 }}" class="aspect-square overflow-hidden bg-panel">
                    <button
                      type="button"
                      commandfor="{{ zoom_dialog_id }}"
                      command="show-modal"
                      data-zoom-preload
                      aria-haspopup="dialog"
                      aria-controls="{{ zoom_dialog_id }}"
                      aria-label="{{ 'product.view_image' | t: title: image_label | escape }}"
                      class="group block size-full cursor-zoom-in bg-panel p-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
                    >
                      {%- if frame_index == 0 -%}
                        {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                      {%- else -%}
                        {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, attributes: 'loading="lazy"' %}{% endblock %}
                      {%- endif -%}
                    </button>
                  </div>
                {%- elsif media.media_type == 'video' -%}
                  <div class="aspect-square overflow-hidden">
                    {% block 'video', video: media, class: 'size-full object-cover' %}{% endblock %}
                  </div>
                {%- elsif media.media_type == 'external_video' -%}
                  {%- liquid
                    assign external_youtube_id = ''
                    assign external_vimeo_id = ''
                    if media.host == 'youtube'
                      assign external_youtube_id = media.external_id
                    elsif media.host == 'vimeo'
                      assign external_vimeo_id = media.external_id
                    endif
                    assign external_video_label = media.alt | default: media.preview_image.alt | default: product_title
                  -%}
                  <div class="aspect-square overflow-hidden">
                    {% block 'video', youtube_id: external_youtube_id, vimeo_id: external_vimeo_id, class: 'size-full object-cover' %}
                      {%- if frame_index == 0 -%}
                        {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                      {%- else -%}
                        {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="lazy"' %}{% endblock %}
                      {%- endif -%}
                    {% endblock %}
                  </div>
                {%- endif -%}
              </div>
              {%- assign frame_index = frame_index | plus: 1 -%}
            {% endfor %}
          </div>
          </s-inspect>
          {% render 'hud-brackets' %}
        </div>

        {%- comment -%} Readout: frame counter and the variant this set belongs to. {%- endcomment -%}
        <div class="mt-3 flex items-center justify-between gap-4 type-data-sm uppercase text-ink-300 md:mt-4 md:px-4">
          <p class="shrink-0">
            {{ 'product.gallery_frame' | t }}
            <span class="text-on-surface" data-frame-current>01</span>/<span>{{ gallery_total_label }}</span>
          </p>
          {%- unless product.has_only_default_variant -%}
            <p class="flex min-w-0 items-center gap-2">
              <span class="inline-block size-1.5 shrink-0 rounded-full bg-info" aria-hidden="true"></span>
              <span class="truncate">{{ 'product.gallery_variant' | t }} <bdi class="text-on-surface">{{ gallery_variant.title | escape }}</bdi></span>
            </p>
          {%- endunless -%}
        </div>

        {%- if gallery_total > 1 -%}
          {%- comment -%} Filmstrip: one thumbnail per frame, plus step controls. The active thumbnail gets the bright line and a cyan marker. {%- endcomment -%}
          <div class="mt-3 flex items-center gap-3 md:px-4">
            <div data-filmstrip role="group" aria-label="{{ 'product.gallery_filmstrip' | t | escape }}" class="flex min-w-0 flex-1 gap-2 overflow-x-auto p-0.5 scrollbar-none [&::-webkit-scrollbar]:hidden">
              {%- assign thumb_index = 0 -%}
              {% for item in gallery_items %}
                {%- liquid
                  if gallery_from_field
                    assign media = item
                  else
                    assign media_position = item | plus: 0
                    assign media = product.media[media_position]
                  endif
                  unless media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video'
                    continue
                  endunless
                  assign thumb_number = thumb_index | plus: 1
                -%}
                <button
                  type="button"
                  data-frame-thumb
                  data-index="{{ thumb_index }}"
                  commandfor="{{ viewport_id }}"
                  command="--frame-go"
                  aria-label="{{ 'product.gallery_show_frame' | t: index: thumb_number, total: gallery_total | escape }}"
                  {% if thumb_index == 0 %}aria-current="true"{% endif %}
                  class="relative size-16 shrink-0 cursor-pointer overflow-hidden border border-line-400 bg-panel p-0 transition-colors duration-150 hover:border-line-200 aria-[current=true]:border-line-100 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-info after:opacity-0 after:content-[''] aria-[current=true]:after:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:size-18"
                >
                  {% block 'image', fallback_image: media.preview_image, alt: '', sizes: '72px', widths: '144,216', placeholder_kind: 'surface', attributes: 'loading="lazy"' %}{% endblock %}
                </button>
                {%- assign thumb_index = thumb_index | plus: 1 -%}
              {% endfor %}
            </div>
            <div class="flex shrink-0 gap-2">
              <button type="button" data-frame-step="prev" commandfor="{{ viewport_id }}" command="--frame-prev" disabled aria-label="{{ 'product.gallery_previous' | t | escape }}" class="inline-flex size-touch-target cursor-pointer items-center justify-center border border-line-300 bg-panel text-on-surface transition-colors duration-150 hover:border-line-100 disabled:cursor-not-allowed disabled:border-line-400 disabled:text-ink-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                <span class="inline-flex size-5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
              </button>
              <button type="button" data-frame-step="next" commandfor="{{ viewport_id }}" command="--frame-next" aria-label="{{ 'product.gallery_next' | t | escape }}" class="inline-flex size-touch-target cursor-pointer items-center justify-center border border-line-300 bg-panel text-on-surface transition-colors duration-150 hover:border-line-100 disabled:cursor-not-allowed disabled:border-line-400 disabled:text-ink-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                <span class="inline-flex size-5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
              </button>
            </div>
          </div>
        {%- endif -%}
      </s-media-viewport>

      {%- assign zoom_widths = '750,1100,1500,2000,2400' | split: ',' -%}
      {% for item in gallery_items %}
        {%- liquid
          if gallery_from_field
            assign media = item
          else
            assign media_position = item | plus: 0
            assign media = product.media[media_position]
          endif
        -%}
        {%- if media.media_type == 'image' -%}
          {%- liquid
            assign zoom_image = media.preview_image | default: media
            assign image_label = media.alt | default: zoom_image.alt | default: product_title
            assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
            assign zoom_title_id = zoom_dialog_id | append: '-title'
          -%}
          {%- capture zoom_srcset -%}
            {%- for width in zoom_widths -%}
              {%- assign image_width = width | strip | plus: 0 -%}
              {{ zoom_image | image_url: width: image_width }} {{ image_width }}w{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- comment -%} Gallery commands open a full-bleed, fade-only surface: no closed transform and no extra backdrop dimming. {%- endcomment -%}
          <s-dialog>
            <dialog id="{{ zoom_dialog_id }}" class="overlay-panel [--panel-backdrop:transparent] fixed inset-0 w-screen h-dvh rounded-none bg-overlay text-surface shadow-none" aria-labelledby="{{ zoom_title_id }}">
              <div class="relative flex size-full items-center justify-center bg-surface">
                <h2 id="{{ zoom_title_id }}" class="sr-only">{{ 'product.image_zoom' | t }}</h2>
                {%- comment -%} Zoom media stays full bleed; only the close control moves inside the safe viewport. {%- endcomment -%}
                {%- capture zoom_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
                {% block 'button', commandfor: zoom_dialog_id, command: 'close', variant: 'button-ghost', class: 'absolute z-10 size-touch-target rounded-none border border-line-300 bg-panel text-on-surface hover:border-line-100 inset-bs-[max(1rem,var(--safe-area-inset-top))] inset-e-[max(1rem,var(--safe-area-inset-inline-end))]', attributes: zoom_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
                <img
                  src="{{ zoom_image | image_url: width: 1500 }}"
                  srcset="{{ zoom_srcset | strip }}"
                  sizes="100vw"
                  loading="lazy"
                  alt="{{ image_label | escape }}"
                  width="{{ zoom_image.width }}"
                  height="{{ zoom_image.height }}"
                  class="size-full object-contain"
                  data-zoom-image
                >
              </div>
            </dialog>
          </s-dialog>
        {%- endif -%}
      {% endfor %}
    </s-product-image-zoom>
    {% endpartial %}
    <script type="module" src="{{ 's-product-image-zoom.js' | asset_url }}"></script>
    <script type="module" src="{{ 's-media-viewport.js' | asset_url }}"></script>
    {% endblock %}

    {%- comment -%} Right: Product Information (40%) {%- endcomment -%}
    {%- comment -%} The product-title and product-form partials declared below are fetched by s-variant-picker.js on product-page variant changes — keep both partial names stable. {%- endcomment -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}

    {%- comment -%} GRID spec sheet: one panel frames title, price, readout rows and the buy form. {%- endcomment -%}
    {% block 'frame', window: 'page', class: 'min-w-0 md:sticky md:top-8 md:self-start' %}
      <div class="panel-header os-pane-bar">
        {% block 'text', tag: 'span', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'product.spec_title' | t }}{% endblock %}
        <span class="type-data-sm text-ink-invert">ITEM.{{ product.id | modulo: 1000 | prepend: '00' | slice: -3, 3 }}</span>
      </div>
    <div class="flex flex-col gap-6 p-4 md:p-6">
      {% partial 'product-title' %}
      <div>
        {% if product.vendor != blank %}
          {% block 'text', variant: 'type-overline', class: 'mb-3 text-ink-300' %}<bdi>{{ product.vendor | escape }}</bdi>{% endblock %}
        {% endif %}
        {% block 'text', tag: 'h1', variant: 'type-heading-xl', class: 'text-on-surface' %}{{ product_title | escape }}{% endblock %}
        <div class="mt-4" data-product-price>
          {% block 'price', price: current_variant.price, compare_at_price: current_variant.compare_at_price, variant: 'type-data-lg' %}{% endblock %}
        </div>
      </div>
      {% endpartial %}

      {%- comment -%} === PRODUCT FORM (commerce-critical) ===
        This {% partial 'product-form' %} region is swapped by s-variant-picker.js on variant change.
        The partial name, the {% form %} tag, and the hidden input[name="id"] are all load-bearing —
        removing or renaming any of them breaks add-to-cart and variant switching.
        <s-product-form> wraps the form so add-to-cart calls Shopify.actions.updateCart
        with the selected variant/quantity while preserving the native product form
        action as the no-JS fallback. standard-actions-override.js keeps the cart
        update on-page by refreshing <s-cart> partials; <s-product-form> then opens
        the drawer with Shopify.actions.openCart(). {%- endcomment -%}
      <s-product-form id="product-buy" class="block" data-product-form data-product-id="{{ product.id }}" data-error-message="{{ 'cart.update_error' | t | escape }}">
        {% partial 'product-form' %}
        {%- comment -%} Read by s-variant-picker.js to resolve the ProductSelectEvent promise
          with the freshly-selected variant. Re-rendered inside the 'product-form' partial
          on every variant change so the next read returns the new variant's data.
          standard_event_data encodes the less-than character as <, so a literal
          closing-script in product metafields cannot terminate this tag early. {%- endcomment -%}
        {%- # theme-check-disable UnknownFilter %}
        <script type="application/json" data-product-view-payload>{{ product | standard_event_data: 'view' }}</script>
        {%- # theme-check-enable UnknownFilter %}
        {%- assign product_form_error_id = 'product-form-error-' | append: product.id -%}
        {%- comment -%} Readout rows live in this partial so status and SKU follow the selected variant. {%- endcomment -%}
        <dl class="mb-6 flex flex-col border-y border-line-400">
          <div class="flex min-h-11 items-center gap-3 border-b border-line-400">
            <dt class="type-overline flex flex-1 items-center gap-3 text-ink-200 after:h-0 after:flex-1 after:border-b after:border-dotted after:border-line-300 after:content-['']">{{ 'product.status_label' | t }}</dt>
            <dd>
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_management != blank and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
                  <span class="badge">{{ 'product.low_stock' | t: count: current_variant.inventory_quantity }}</span>
                {%- else -%}
                  <span class="badge badge-success">{{ 'product.in_stock' | t }}</span>
                {%- endif -%}
              {%- else -%}
                <span class="badge badge-danger">{{ 'product.sold_out' | t }}</span>
              {%- endif -%}
            </dd>
          </div>
          {%- if product.type != blank -%}
            <div class="flex min-h-11 items-center gap-3 border-b border-line-400">
              <dt class="type-overline flex flex-1 items-center gap-3 text-ink-200 after:h-0 after:flex-1 after:border-b after:border-dotted after:border-line-300 after:content-['']">{{ 'product.type_label' | t }}</dt>
              <dd class="type-data uppercase text-on-surface"><bdi>{{ product.type | escape }}</bdi></dd>
            </div>
          {%- endif -%}
          {%- if current_variant.sku != blank -%}
            <div class="flex min-h-11 items-center gap-3 border-b border-line-400">
              <dt class="type-overline flex flex-1 items-center gap-3 text-ink-200 after:h-0 after:flex-1 after:border-b after:border-dotted after:border-line-300 after:content-['']">{{ 'product.sku_label' | t }}</dt>
              <dd class="type-data text-on-surface"><bdi>{{ current_variant.sku | escape }}</bdi></dd>
            </div>
          {%- endif -%}
        </dl>
        {%- comment -%} Config terminal: the configured unit as a mono readout; re-rendered with this partial on every variant change, and mirrored by the docked add-to-cart. {%- endcomment -%}
        {%- liquid
          assign config_variant = current_variant.title
          if product.has_only_default_variant
            assign config_variant = 'product.config_default' | t
          endif
          assign config_type = product.type | default: product.vendor
        -%}
        <p class="grid-terminal mb-6" data-config-string>
          <span class="grid-terminal-prompt" aria-hidden="true">&gt;</span>
          <span class="text-ink-300">{{ 'product.config_label' | t }}:</span>
          {%- if config_type != blank -%}<span>{{ config_type | escape }}</span><span class="grid-terminal-sep" aria-hidden="true">//</span>{%- endif -%}
          <span class="text-accent">{{ config_variant | escape }}</span>
          {%- if current_variant.sku != blank -%}<span class="grid-terminal-sep" aria-hidden="true">//</span><span>{{ current_variant.sku | escape }}</span>{%- endif -%}
          <span class="grid-cursor" aria-hidden="true"></span>
        </p>
        {% form 'product', product, id: 'product-form-main' %}
          {% if product.variants.size > 1 %}
            <s-variant-picker class="block space-y-4" data-updated-message="{{ 'accessibility.variant_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t | escape }}" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}">
              {%- for option in product.options_with_values -%}
                {%- block 'variant-picker', product: product, option: option, show_selected_value: true -%}{%- endblock -%}
              {%- endfor -%}
              {%- comment -%} Variant refresh feedback stays separate from the add-to-cart error owned by s-product-form. {%- endcomment -%}
              <p data-variant-picker-error hidden class="text-sm text-sale">{{ 'accessibility.update_error' | t }}</p>
            </s-variant-picker>
          {% endif %}
          {%- comment -%} The sole submitted variant ID stays in the partial across selector styles and single-variant products; s-variant-picker updates it on change. {%- endcomment -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <div class="flex items-center gap-4 mb-6">
            <div class="shrink-0">
              <label for="product-quantity" class="type-overline mb-2 block text-ink-300">{{ 'product.quantity' | t }}</label>
              {%- liquid
                assign qty_min = current_variant.quantity_rule.min | default: 1
                assign qty_max = current_variant.quantity_rule.max
                assign qty_step = current_variant.quantity_rule.increment | default: 1
              -%}
              {% block 'quantity-selector', id: 'product-quantity', name: 'quantity', value: qty_min, min: qty_min, max: qty_max, step: qty_step, class: 'border border-line-300 rounded-none' %}{% endblock %}
            </div>
          </div>

          {%- if current_variant.available -%}
            {%- capture add_button_attrs -%}aria-describedby="{{ product_form_error_id }}"{%- endcapture -%}
            {% block 'button', type: 'submit', name: 'add', variant: 'button-primary', class: 'h-11 px-3 text-sm rounded-button w-full', attributes: add_button_attrs %}{{- 'product.add_to_cart' | t -}}{% endblock %}
          {%- else -%}
            {%- comment -%}
              type="button" prevents keyboard form submission when sold out; aria-disabled is set by the block.
              That leaves no signal the button block can read, so inert states the placeholder has no destination.
            {%- endcomment -%}
            {% block 'button', type: 'button', inert: true, variant: 'button-secondary', class: 'h-11 px-3 text-sm w-full border-line-400 text-ink-400', disabled: true %}{{- 'product.sold_out' | t -}}{% endblock %}
            {% block 'text', variant: 'type-data-sm', class: 'mt-3 flex items-center gap-2 uppercase text-critical' %}<span class="grid-status-dot grid-status-dot-alert" aria-hidden="true"></span>{{ 'product.sold_out_error' | t }}<span class="grid-cursor" aria-hidden="true"></span>{% endblock %}
          {%- endif -%}

          <p id="{{ product_form_error_id }}" data-add-to-cart-error role="alert" hidden class="mt-3 text-sm text-sale"></p>

          <div class="mt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
            {{ form | payment_button }}
          </div>
        {% endform %}

        {% endpartial %}
      </s-product-form>

      {%- comment -%} Product Description {%- endcomment -%}
      {%- comment -%} Unconditional sr-only h2 ensures heading hierarchy is valid even when no description exists, preserving the semantic outline across all product pages {%- endcomment -%}
      <h2 class="sr-only">{{ 'product.details' | t }}</h2>

      {%- comment -%} GRID tabs window: README (the product description), SHIPPING and SUPPORT. Radio-driven, so arrow keys move between tabs natively; tab copy lives in text blocks. {%- endcomment -%}
      <div class="grid-tabs" role="group" aria-label="{{ 'product.tabs_label' | t | escape }}">
        {%- if product.description != blank -%}
          <input type="radio" name="product-tabs-{{ product.id }}" id="product-tab-readme-{{ product.id }}" checked>
          <label for="product-tab-readme-{{ product.id }}" class="grid-tab type-overline">{{ 'product.readme_title' | t }}</label>
        {%- endif -%}
        <input type="radio" name="product-tabs-{{ product.id }}" id="product-tab-shipping-{{ product.id }}"{% if product.description == blank %} checked{% endif %}>
        <label for="product-tab-shipping-{{ product.id }}" class="grid-tab type-overline">{{ 'product.tab_shipping' | t }}</label>
        <input type="radio" name="product-tabs-{{ product.id }}" id="product-tab-support-{{ product.id }}">
        <label for="product-tab-support-{{ product.id }}" class="grid-tab type-overline">{{ 'product.tab_support' | t }}</label>

        {%- if product.description != blank -%}
          <div class="grid-tab-pane">
            {%- comment -%} The schema-backed setting keeps the product description connected as rich text instead of flattening its internal treatments through the text block. {%- endcomment -%}
            {% block 'richtext', text: product.description, class: 'type-body max-w-[68ch] text-ink-200' %}{% endblock %}
          </div>
        {%- endif -%}
        <div class="grid-tab-pane">
          {% block 'text', variant: 'type-body', class: 'max-w-[68ch] text-ink-200' %}{{ 'product.tab_shipping_body' | t }}{% endblock %}
        </div>
        <div class="grid-tab-pane">
          {% block 'text', variant: 'type-body', class: 'max-w-[68ch] text-ink-200' %}{{ 'product.tab_support_body' | t }}{% endblock %}
        </div>
      </div>

      {%- comment -%} Records this product for the status bar's recently viewed windows. {%- endcomment -%}
      {%- liquid
        assign recent_image = ''
        if product.featured_image
          assign recent_image = product.featured_image | image_url: width: 64
        endif
      -%}
      <s-recent mode="record" hidden data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-image="{{ recent_image }}"></s-recent>
    </div>
    {% endblock %}
  </div>
  </s-view-event>

  {%- liquid
    # Ride windows show for snowboards, or any product that has ride ratings. Ratings read
    # custom.flex / custom.terrain / custom.speed / custom.ability (integer 1–10) and fall
    # back to stable per-product demo values until those metafields are filled in.
    assign has_ratings = false
    if product.metafields.custom.flex != blank
      assign has_ratings = true
    endif
    assign is_board = false
    if product.type == 'snowboard' or has_ratings
      assign is_board = true
    endif
    assign demo_flex = product.id | modulo: 6 | plus: 3
    assign demo_terrain = product.id | divided_by: 7 | modulo: 5 | plus: 5
    assign demo_speed = product.id | divided_by: 13 | modulo: 6 | plus: 4
    assign demo_level = product.id | divided_by: 17 | modulo: 7 | plus: 3
    assign rating_flex = product.metafields.custom.flex.value | default: demo_flex
    assign rating_terrain = product.metafields.custom.terrain.value | default: demo_terrain
    assign rating_speed = product.metafields.custom.speed.value | default: demo_speed
    assign rating_level = product.metafields.custom.ability.value | default: demo_level

    assign related_collection = nil
    for related_candidate in product.collections
      if related_candidate.products_count > 1
        assign related_collection = related_candidate
        break
      endif
    endfor
  -%}

  {%- if is_board or related_collection != blank -%}
    <div class="mb-16 grid grid-cols-1 gap-3 lg:grid-cols-12">
      {%- if is_board -%}
        {%- comment -%} TELEMETRY: the ride profile as segmented meters. {%- endcomment -%}
        {% block 'frame', window: 'pane', span: '6', readout: 'status', class: 'min-w-0' %}
          <div class="panel-header os-pane-bar">
            {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'product.telemetry_title' | t }}{% endblock %}
          </div>
          <div class="flex flex-col gap-5 p-4 md:p-6">
            {% block 'text', tag: 'p', variant: 'type-heading-lg', class: 'text-on-surface' %}{{ 'product.telemetry_heading' | t }}{% endblock %}
            <dl class="flex flex-col gap-4">
              <div class="grid grid-cols-[7rem_minmax(0,1fr)_3rem] items-center gap-3">
                <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-200' %}{{ 'product.meter_flex' | t }}{% endblock %}</dt>
                {% render 'meter-segments', value: rating_flex %}
                <dd class="type-data-sm text-end text-on-surface"><span aria-hidden="true">{{ rating_flex | prepend: '0' | slice: -2, 2 }}</span><span class="sr-only">{{ 'product.meter_value' | t: value: rating_flex }}</span></dd>
              </div>
              <div class="grid grid-cols-[7rem_minmax(0,1fr)_3rem] items-center gap-3">
                <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-200' %}{{ 'product.meter_terrain' | t }}{% endblock %}</dt>
                {% render 'meter-segments', value: rating_terrain %}
                <dd class="type-data-sm text-end text-on-surface"><span aria-hidden="true">{{ rating_terrain | prepend: '0' | slice: -2, 2 }}</span><span class="sr-only">{{ 'product.meter_value' | t: value: rating_terrain }}</span></dd>
              </div>
              <div class="grid grid-cols-[7rem_minmax(0,1fr)_3rem] items-center gap-3">
                <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-200' %}{{ 'product.meter_speed' | t }}{% endblock %}</dt>
                {% render 'meter-segments', value: rating_speed %}
                <dd class="type-data-sm text-end text-on-surface"><span aria-hidden="true">{{ rating_speed | prepend: '0' | slice: -2, 2 }}</span><span class="sr-only">{{ 'product.meter_value' | t: value: rating_speed }}</span></dd>
              </div>
              <div class="grid grid-cols-[7rem_minmax(0,1fr)_3rem] items-center gap-3">
                <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-200' %}{{ 'product.meter_level' | t }}{% endblock %}</dt>
                {% render 'meter-segments', value: rating_level %}
                <dd class="type-data-sm text-end text-on-surface"><span aria-hidden="true">{{ rating_level | prepend: '0' | slice: -2, 2 }}</span><span class="sr-only">{{ 'product.meter_value' | t: value: rating_level }}</span></dd>
              </div>
            </dl>
          </div>
        {% endblock %}

        {%- comment -%} SIZE.CALC: height and weight in, a recommended board length out. {%- endcomment -%}
        {% block 'frame', window: 'pane', span: '6', entrance: 'scan', class: 'min-w-0' %}
          <div class="panel-header os-pane-bar">
            {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'product.size_title' | t }}{% endblock %}
          </div>
          <s-size-calc class="flex flex-col gap-5 p-4 md:p-6" data-invalid="{{ 'product.size_invalid' | t | escape }}">
            {% block 'text', tag: 'p', variant: 'type-heading-lg', class: 'text-on-surface' %}{{ 'product.size_heading' | t }}{% endblock %}
            <form class="grid grid-cols-2 gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
              <label class="flex flex-col gap-2">
                <span class="type-overline text-ink-300">{{ 'product.size_height' | t }}</span>
                <input type="number" name="height" inputmode="numeric" min="120" max="220" placeholder="175" required class="h-11 border border-line-300 bg-surface-secondary px-3 type-data text-on-surface outline-none focus:border-accent">
              </label>
              <label class="flex flex-col gap-2">
                <span class="type-overline text-ink-300">{{ 'product.size_weight' | t }}</span>
                <input type="number" name="weight" inputmode="numeric" min="30" max="160" placeholder="70" class="h-11 border border-line-300 bg-surface-secondary px-3 type-data text-on-surface outline-none focus:border-accent">
              </label>
              {% block 'button', type: 'submit', variant: 'button-secondary', class: 'col-span-2 h-11 px-5 text-[13px] sm:col-span-1' %}{{- 'product.size_cta' | t -}}{% endblock %}
            </form>
            <div class="flex min-h-11 items-center gap-3 border-y border-line-400">
              <span class="type-overline flex flex-1 items-center gap-3 text-ink-200 after:h-0 after:flex-1 after:border-b after:border-dotted after:border-line-300 after:content-['']">{{ 'product.size_result_label' | t }}</span>
              <output class="type-data text-[14px] text-accent" data-size-result aria-live="polite">{{ 'product.size_result_empty' | t }}</output>
            </div>
            {% block 'text', variant: 'type-body-sm', class: 'text-ink-300' %}{{ 'product.size_note' | t }}{% endblock %}
          </s-size-calc>
        {% endblock %}
      {%- endif -%}

      {%- if related_collection != blank -%}
        {%- comment -%} RELATED.DIR: other units from this product's collection, as a file listing with target lock and compare. {%- endcomment -%}
        {% block 'frame', window: 'pane', span: '12', class: 'min-w-0' %}
          <div class="panel-header os-pane-bar">
            {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'product.related_title' | t }}{% endblock %}
            <span class="type-data-sm uppercase text-ink-invert">{{ related_collection.title | escape }}</span>
          </div>
          <ul role="list" class="-mb-px -me-px grid grid-cols-2 md:grid-cols-4">
            {%- assign related_shown = 0 -%}
            {%- for related in related_collection.products limit: 5 -%}
              {%- if related.id == product.id or related_shown >= 4 -%}{%- continue -%}{%- endif -%}
              {%- assign related_shown = related_shown | plus: 1 -%}
              {%- assign related_variant = related.selected_or_first_available_variant -%}
              <li class="border-b border-e border-line-400 bg-panel">
                {%- capture card_ql_attrs -%}data-quick-look="{{ related.url | escape }}"{%- endcapture -%}
                {% block 'card', block.name: 't:blocks.product_card', url: related.url, aria_label: related.title, class: 'h-full p-3 md:p-4', attributes: card_ql_attrs %}
                  <a href="{{ related.url | escape }}" style="view-transition-name: pimg-{{ related.id }}" class="relative block overflow-hidden border border-line-400 bg-surface motion-safe:transition-colors group-hover/card:border-line-100" aria-label="{{ related.title | escape }}">
                    {% block 'image', fallback_image: related.featured_image, aspect_ratio: 'aspect-square', sizes: '(min-width: 768px) 25vw, 50vw', attributes: 'loading="lazy"', alt: related.title %}{% endblock %}
                    {% render 'hud-brackets', class: 'card-lock hud-brackets-accent' %}<span class="card-lock-tag" aria-hidden="true">{{ 'product.lock_tag' | t }}</span>
                  </a>
                  <div class="flex flex-col gap-1 pt-1">
                    {% block 'text', variant: 'type-heading-sm', tag: 'h3', class: 'line-clamp-2 text-on-surface' %}{{ related.title | escape }}{% endblock %}
                    {% block 'price', price: related_variant.price, compare_at_price: related_variant.compare_at_price, price_min: related.price_min, price_max: related.price_max, variant: 'type-data', class: 'self-start' %}{% endblock %}
                  </div>
                  {% render 'compare-toggle', product: related %}
                {% endblock %}
              </li>
            {%- endfor -%}
          </ul>
        {% endblock %}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if product.available -%}
    {%- comment -%} Docked add-to-cart: appears once the buy area scrolls above the viewport; its Add button submits the main product form, so variant, quantity and the cart transfer all behave as the main button does. {%- endcomment -%}
    <s-dock class="grid-dock" target="product-buy" role="region" aria-label="{{ 'product.dock_label' | t | escape }}">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 96 }}" alt="" width="40" height="40" loading="lazy">
      {%- endif -%}
      <div class="flex min-w-0 flex-1 flex-col gap-0.5">
        <span class="type-heading-sm truncate text-on-surface">{{ product_title | escape }}</span>
        <span class="type-data truncate text-[11px] uppercase text-ink-300" data-dock-mirror="[data-config-string]"></span>
      </div>
      <span class="type-data shrink-0 text-on-surface" data-dock-mirror="[data-product-price]"></span>
      {% block 'button', type: 'submit', name: 'add', variant: 'button-primary', class: 'h-11 shrink-0 px-4 text-[13px]', attributes: 'form="product-form-main"' %}{{- 'product.dock_add' | t -}}{% endblock %}
    </s-dock>
  {%- endif -%}


  <script type="module" src="{{ 's-variant-picker.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-product-form.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-inspect.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-dock.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-size-calc.js' | asset_url }}"></script>
{% endblock %}
