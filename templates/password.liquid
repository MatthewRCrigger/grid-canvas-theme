{% layout 'password' %}

{%- liquid
  # GRID placeholder art first (DESIGN.md: never a product stand-in), then the Brand cover image.
  assign launch_fallback_image = images['grid-dev-terminal-gate.png'] | default: shop.brand.cover_image
  assign launch_image_alt = 'password.image_alt' | t

  assign password_year = 'now' | date: '%Y'
  assign password_title = 'password.title' | t
  assign password_eyebrow = 'password.eyebrow' | t
  assign password_launch_description = 'password.launch_description' | t
  assign password_enter = 'password.enter' | t
  assign password_enter_with_password = 'password.enter_with_password' | t
  assign password_enter_store = 'password.enter_store' | t
  assign password_show = 'password.show' | t
  assign password_hide = 'password.hide' | t
  assign password_get_updates = 'password.get_updates' | t
  assign password_updates_description = 'password.updates_description' | t
  assign password_updates_submit = 'password.updates_submit' | t
  assign password_updates_success = 'password.updates_success' | t
  assign password_field_label = 'password.field_label' | t
  assign password_placeholder = 'password.placeholder' | t
  assign password_error_message = 'password.error' | t
  assign email_label = 'contact.email' | t
  assign required_label = 'forms.required' | t
-%}

{%- comment -%} Menu bar: the lock screen's slim version of the store menu bar (wordmark, LOGIN app slot, status + clock). {%- endcomment -%}
{% block 'header', class: 'relative z-40 shrink-0 border-b border-line-300 bg-surface' %}
  <div class="flex min-h-11 items-center gap-4 px-margin">
    {% block 'logo', class: 'min-h-touch-target font-heading text-[14px] font-semibold uppercase tracking-[0.28em]' %}{% endblock %}
    <span class="h-4 w-px bg-line-300" aria-hidden="true"></span>
    {% block 'text', tag: 'span', variant: 'type-overline', class: 'text-accent' %}{{ 'os.login_title' | t }}{% endblock %}
    <span class="ms-auto inline-flex items-center gap-2 type-data-sm uppercase text-ink-200" aria-hidden="true">
      {% render 'os-icon', name: 'lock', class: 'size-4' %}
      <s-clock class="hidden sm:inline">--:--:--</s-clock>
    </span>
  </div>
{% endblock %}

{%- comment -%}
  Lock screen: the focused LOGIN window beside an ACCESS readout, centred on the grid-floor wallpaper.
  No background here, so the global wallpaper shows through. Phones stack LOGIN first.
{%- endcomment -%}
{% block 'container', tag: 'div', class: 'os-stage flex-1 lg:h-[calc(100dvh-var(--os-menubar-h)-var(--os-dock-space))] lg:flex-none', attributes: 'data-password-page' %}
  <div class="os-stage-inner flex min-h-full items-center py-6 lg:py-0">
    {%- comment -%}
      LOGIN: one window, two columns. Copy and the inline password form on the start side; the ACCESS
      readout as a hairline-divided side column (stacks under the form on phones). Opening updates
      sits in the window's bottom rule as the secondary path.
    {%- endcomment -%}
    {% block 'frame', window: 'none', class: 'mx-auto w-full min-w-0 max-w-5xl', variant: 'frame-grid' %}
      <div class="panel-header os-pane-bar">
        {% block 'text', tag: 'span', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'os.login_title' | t }}{% endblock %}
        <span class="os-page-meta ms-auto" aria-hidden="true">{{ 'password.window_meta' | t }}</span>
      </div>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="min-w-0 p-5 md:p-8 lg:p-12">
          {% block 'text', variant: 'type-overline', class: 'mb-6 flex items-center gap-2 text-accent' %}
            <span class="grid-status-dot grid-status-dot-alert" aria-hidden="true"></span>{{- password_eyebrow -}}
          {% endblock %}

          {% block 'text', tag: 'h1', variant: 'type-heading-2xl', class: 'max-w-full break-words' %}
            {%- if shop.password_message != blank -%}
              {{- shop.password_message | escape -}}
            {%- else -%}
              {{- password_title -}}
            {%- endif -%}
          {% endblock %}

          {% block 'text', variant: 'type-body-lg', class: 'mt-4 max-w-prose text-on-surface-secondary' %}
            {{- password_launch_description -}}
          {% endblock %}

          {%- comment -%} Inline login: Shopify's native password form, right in the window. Shopify owns validation and the redirect into the store. {%- endcomment -%}
          {% form 'storefront_password', id: 'password-entry-form', class: 'mt-8 border-t border-line-400 pt-6' %}
            <label for="password-entry" class="type-overline mb-2 block text-ink-300">{{ password_field_label }}</label>
            <div class="flex flex-col gap-3 sm:flex-row">
              <s-password-field id="password-entry-field" class="relative block min-w-0 flex-1">
                <input
                  type="password"
                  name="password"
                  id="password-entry"
                  class="h-12 w-full pe-24"
                  placeholder="{{ password_placeholder | escape }}"
                  autocomplete="current-password"
                  required
                  aria-required="true"
                  {%- if form.errors %} autofocus aria-invalid="true" aria-describedby="password-entry-error"{% endif %}
                >
                {%- capture password_toggle_attrs -%}aria-controls="password-entry" aria-pressed="false" data-show-label="{{ password_show | escape }}" data-hide-label="{{ password_hide | escape }}"{%- endcapture -%}
                {% block 'button', commandfor: 'password-entry-field', command: '--toggle-password', variant: 'button-ghost', class: 'absolute inset-y-1 end-1 min-w-touch-target px-3 type-overline hover:bg-hover', attributes: password_toggle_attrs %}<span data-password-toggle-label>{{ password_show }}</span>{% endblock %}
              </s-password-field>
              {% block 'button', type: 'submit', variant: 'button-primary', class: 'h-12 shrink-0 justify-center gap-3 px-6' %}
                {% render 'os-icon', name: 'lock', class: 'size-4' %}
                <span>{{- password_enter_store -}}</span>
              {% endblock %}
            </div>
            {%- if form.errors -%}
              <p id="password-entry-error" class="mt-2 flex items-center gap-2 text-[12px] text-critical" role="alert"><span class="grid-status-dot grid-status-dot-alert" aria-hidden="true"></span>{{ password_error_message }}</p>
            {%- endif -%}
          {% endform %}

        <noscript>
          <div class="mt-6 border-t border-line-400 pt-6">
            {% form 'customer', id: 'password-updates-fallback' %}
              <details {% if form.posted_successfully? or form.errors %}open{% endif %}>
                <summary class="min-h-touch-target cursor-pointer py-3 font-medium">{{ password_get_updates }}</summary>
                <div class="mt-3 space-y-4">
                  {%- if form.posted_successfully? -%}
                    <p role="status">{{ password_updates_success }}</p>
                  {%- else -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    {%- if form.errors -%}
                      <div id="password-updates-fallback-error" class="text-sm text-critical" role="alert">
                        <p class="font-medium">{{ 'forms.form_errors_title' | t }}</p>
                        <ul class="mt-1 list-disc ps-4">
                          {%- for field in form.errors -%}
                            <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                    <div>
                      <label for="password-updates-fallback-email" class="type-overline mb-2 block text-ink-300">
                        {{- email_label -}}
                        <span class="ms-0.5 text-critical" aria-hidden="true">*</span><span class="sr-only"> ({{ required_label }})</span>
                      </label>
                      <input
                        type="email"
                        id="password-updates-fallback-email"
                        name="contact[email]"
                        value="{{ form.email | escape }}"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        required
                        aria-required="true"
                        {%- if form.errors %} aria-invalid="true" aria-describedby="password-updates-fallback-error"{% endif %}
                      >
                    </div>
                    {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_updates_submit }}{% endblock %}
                  {%- endif -%}
                </div>
              </details>
            {% endform %}
          </div>
        </noscript>
        </div>

        {%- comment -%} ACCESS readout: the gate's state as key-value rows, then the lock waiting for a key. {%- endcomment -%}
        <aside class="flex min-w-0 flex-col border-t border-line-300 lg:border-t-0 lg:border-s" aria-labelledby="password-access-title">
          <div class="flex min-h-11 items-center justify-between gap-3 border-b border-line-400 px-4">
            {% block 'text', tag: 'h2', variant: 'type-overline', class: 'text-ink-300', attributes: 'id="password-access-title"' %}{{ 'password.panel_title' | t }}{% endblock %}
            <span class="type-data-sm uppercase text-ink-300" aria-hidden="true">{{ 'password.gate_meta' | t }}</span>
          </div>

          {%- if launch_fallback_image != blank -%}
            <div class="hud-viewport border-b border-line-400 bg-surface">
              {% block 'image', fallback_image: launch_fallback_image, aspect_ratio: 'aspect-[3/2]', sizes: '(min-width: 1024px) 320px, calc(100vw - 48px)', alt: launch_image_alt, attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
              {% render 'hud-brackets' %}
            </div>
          {%- endif -%}

          <dl class="px-4">
            <div class="flex items-baseline gap-3 border-b border-line-400 py-3">
              <dt class="type-body-sm text-ink-300">{{ 'password.status_label' | t }}</dt>
              <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
              <dd class="type-data uppercase text-accent">{{ 'password.status_value' | t }}</dd>
            </div>
            <div class="flex items-baseline gap-3 border-b border-line-400 py-3">
              <dt class="shrink-0 type-body-sm text-ink-300">{{ 'password.network_label' | t }}</dt>
              <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
              <dd class="min-w-0 truncate type-data uppercase text-on-surface" dir="ltr">{{ shop.domain | escape }}</dd>
            </div>
            <div class="flex items-baseline gap-3 py-3">
              <dt class="type-body-sm text-ink-300">{{ 'password.time_label' | t }}</dt>
              <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
              <dd class="type-data text-on-surface"><s-clock>--:--:--</s-clock></dd>
            </div>
          </dl>

          {%- comment -%} Lock well: fills the rest of the column on desktop so both sides end on the same line. {%- endcomment -%}
          <div class="m-4 mt-auto flex flex-col items-center justify-center gap-4 border border-line-400 bg-surface-secondary px-4 py-8 lg:flex-1 lg:mt-4" aria-hidden="true">
            <span class="grid size-16 place-items-center border border-line-300 text-ink-200">
              {% render 'os-icon', name: 'lock', class: 'size-8' %}
            </span>
            <span class="flex items-center gap-1 type-data-sm uppercase text-ink-300">{{ 'password.awaiting_key' | t }}<span class="grid-cursor"></span></span>
          </div>
        </aside>
      </div>

      {%- comment -%} Bottom rule: opening updates as the secondary path (a pop-up), never competing with ENTER STORE. {%- endcomment -%}
      <div class="flex flex-col gap-3 border-t border-line-300 px-5 py-4 sm:flex-row sm:items-center sm:justify-between md:px-8 lg:px-12">
        <div class="min-w-0">
          {% block 'text', tag: 'p', variant: 'type-overline', class: 'text-on-surface' %}{{ password_get_updates }}{% endblock %}
          {% block 'text', variant: 'type-body-sm', class: 'mt-1 text-ink-300' %}{{ password_updates_description }}{% endblock %}
        </div>
        {%- capture updates_trigger_attrs -%}id="password-updates-trigger" aria-haspopup="dialog" aria-controls="password-updates-dialog"{%- endcapture -%}
        {% block 'button', commandfor: 'password-updates-dialog', command: 'show-modal', variant: 'button-secondary', class: 'min-h-touch-target shrink-0 justify-center gap-3 px-5', attributes: updates_trigger_attrs %}
          {% render 'os-icon', name: 'mail', class: 'size-4' %}
          <span>{{ 'password.notify_cta' | t }}</span>
        {% endblock %}
      </div>
    {% endblock %}
  </div>
{% endblock %}

{%- comment -%} Footer: the store's two mono corners (pinned either side of the dock from 64rem). {%- endcomment -%}
{% block 'footer', class: 'os-footer' %}
  <div class="os-footer-start flex flex-wrap items-center gap-x-6 gap-y-1">
    <p class="m-0">&copy; {{ password_year }} {{ shop.name | escape }}</p>
    {% render 'social-links', class: 'justify-start' %}
  </div>
  <p class="os-footer-end m-0 wrap-anywhere" dir="ltr">{{ shop.domain | escape }}</p>
{% endblock %}

{% form 'customer', id: 'password-updates-form', class: 'absolute' %}
  <s-dialog {% if form.posted_successfully? or form.errors %}open-on-connect{% endif %}>
    <dialog id="password-updates-dialog" class="overlay-panel m-auto text-on-surface w-[min(560px,90vw,calc(100vw-var(--safe-area-inset-inline)-var(--safe-area-inset-inline)))] max-h-dialog-max-height max-w-md" aria-labelledby="password-updates-title">
      {% block 'frame', id: 'password-updates-window', window: 'dialog', entrance: 'none' %}
        <div class="panel-header">
          <span class="type-overline-lg truncate text-ink-invert">{{ 'os.dock_updates' | t }}</span>
        </div>
        <div class="min-h-0 overflow-y-auto p-6 sm:p-8">

      {% block 'text', tag: 'h2', variant: 'type-heading-lg', attributes: 'id="password-updates-title"' %}
        {{- password_get_updates -}}
      {% endblock %}

      {%- if form.posted_successfully? -%}
        <p class="mt-6 type-body" role="status" tabindex="-1" autofocus>{{ password_updates_success }}</p>
      {%- else -%}
        {% block 'text', variant: 'type-body', class: 'mt-4 text-on-surface-secondary' %}
          {{- password_updates_description -}}
        {% endblock %}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="mt-7 space-y-5">
          {%- if form.errors -%}
            <div id="password-updates-error" class="text-sm text-critical" role="alert">
              <p class="font-medium">{{ 'forms.form_errors_title' | t }}</p>
              <ul class="mt-1 list-disc ps-4">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div>
            <label for="password-updates-email" class="type-overline mb-2 block text-ink-300">
              {{- email_label -}}
              <span class="ms-0.5 text-critical" aria-hidden="true">*</span><span class="sr-only"> ({{ required_label }})</span>
            </label>
            <input
              type="email"
              id="password-updates-email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              aria-required="true"
              autofocus
              {%- if form.errors %} aria-invalid="true" aria-describedby="password-updates-error"{% endif %}
            >
          </div>

          {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_updates_submit }}{% endblock %}
        </div>
      {%- endif -%}
        </div>
      {% endblock %}
    </dialog>
  </s-dialog>
{% endform %}

{%- comment -%} Password dock: the store's pages are locked, so the dock carries what works here (Desktop, which lands back on this screen, plus the password and updates dialogs). {%- endcomment -%}
{% block 'dock', hide_recents: true %}
  {% block 'dock-item', icon: 'finder', url: routes.root_url %}
    {% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'os.dock_home' | t }}{% endblock %}
  {% endblock %}
  {% block 'dock-item', icon: 'lock', commandfor: 'password-entry-field', command: '--focus' %}
    {% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'os.dock_enter' | t }}{% endblock %}
  {% endblock %}
  {% block 'dock-item', icon: 'mail', commandfor: 'password-updates-dialog', command: 'show-modal' %}
    {% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'os.dock_updates' | t }}{% endblock %}
  {% endblock %}
{% endblock %}

<script type="module" src="{{ 's-dialog.js' | asset_url }}"></script>
<script type="module" src="{{ 's-password-field.js' | asset_url }}"></script>
