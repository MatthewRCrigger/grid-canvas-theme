      {% block 'collection-directory' %}{% endblock %}
  {% endblock %}

  {% block 'frame', readout: 'status', entrance: 'scan', id: 'win-log', window: 'closed', class: 'lg:absolute lg:start-[44%] lg:top-[160px] lg:w-[min(30%,420px)]' %}
