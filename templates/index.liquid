          <span class="type-data text-[11px] text-ink-300" aria-hidden="true">{{ 'home.os.log_ok' | t }}</span>
        </li>
        <li class="flex min-h-10 items-center gap-3 border-b border-line-400 px-2">
          <span class="type-data-sm text-info" aria-hidden="true">&gt;</span>
          {% block 'text', tag: 'span', variant: 'type-data-sm', class: 'flex-1 uppercase text-ink-200' %}{{ 'home.os.log_5' | t }}{% endblock %}
          <span class="type-data text-[11px] text-ink-300" aria-hidden="true">{{ 'home.os.log_ok' | t }}</span>
        </li>
        <li class="flex min-h-10 items-center gap-3 px-2" aria-hidden="true">
          <span class="type-data-sm text-info">&gt;</span>
          <span class="grid-cursor text-accent"></span>
        </li>
      </ol>
  {% endblock %}

  {%- comment -%}
