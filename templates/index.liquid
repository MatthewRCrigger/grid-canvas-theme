          {% block 'text', tag: 'span', variant: 'hud-tag', class: 'border-info text-info' %}{{ 'home.scan.tag' | t }}{% endblock %}
        </div>
      </div>
      <dl class="absolute end-[7%] top-[6%] z-[2] w-[54%] border border-line-300 bg-surface md:w-[46%]">
          <div class="flex min-h-8 items-center gap-2 border-b border-line-400 px-2 last:border-b-0 md:px-3">
            <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-300' %}{{ 'home.scan.alt_label' | t }}{% endblock %}</dt>
            <span class="flex-1 translate-y-[3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'type-data-sm', class: 'text-on-surface' %}{{ 'home.scan.alt_value' | t }}{% endblock %}</dd>
          </div>
          <div class="flex min-h-8 items-center gap-2 border-b border-line-400 px-2 last:border-b-0 md:px-3">
            <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-300' %}{{ 'home.scan.slope_label' | t }}{% endblock %}</dt>
            <span class="flex-1 translate-y-[3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'type-data-sm', class: 'text-on-surface' %}{{ 'home.scan.slope_value' | t }}{% endblock %}</dd>
          </div>
          <div class="flex min-h-8 items-center gap-2 border-b border-line-400 px-2 last:border-b-0 md:px-3">
            <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-300' %}{{ 'home.scan.temp_label' | t }}{% endblock %}</dt>
            <span class="flex-1 translate-y-[3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'type-data-sm', class: 'text-on-surface' %}{{ 'home.scan.temp_value' | t }}{% endblock %}</dd>
          </div>
          <div class="flex min-h-8 items-center gap-2 border-b border-line-400 px-2 last:border-b-0 md:px-3">
            <dt>{% block 'text', tag: 'span', variant: 'type-overline', class: 'text-ink-300' %}{{ 'home.scan.wind_label' | t }}{% endblock %}</dt>
            <span class="flex-1 translate-y-[3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'type-data-sm', class: 'text-on-surface' %}{{ 'home.scan.wind_value' | t }}{% endblock %}</dd>
          </div>
      </dl>
    </div>
  {% endblock %}

  {% block 'frame', readout: 'status', id: 'win-readme', window: 'closed', class: 'lg:absolute lg:start-[34%] lg:top-[56px] lg:w-[min(40%,580px)]', inner_class: 'flex flex-col' %}
      <div class="panel-header">
        {% block 'text', tag: 'span', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'home.scan.title' | t }}{% endblock %}
        {% block 'text', tag: 'span', variant: 'type-data-sm', class: 'uppercase text-ink-invert' %}{{ 'home.scan.index' | t }}{% endblock %}
      </div>
      <div class="flex flex-1 flex-col justify-between gap-12 p-4 md:p-10">
        {% block 'text', tag: 'h2', variant: 'type-display' %}{{ 'home.field.readme_heading' | t }}{% endblock %}
        <div class="flex flex-col gap-6 border-t border-line-300 pt-6">
          {% block 'text', variant: 'type-body-lg', class: 'max-w-[52ch] text-ink-200' %}{{ 'home.field.readme_body' | t }}{% endblock %}
          <div>
            {% block 'button', url: routes.all_products_collection_url, variant: 'button-secondary', class: 'h-11 px-5 text-[13px]' %}{{ 'home.field.readme_cta' | t }}{% endblock %}
          </div>
        </div>
      </div>
  {% endblock %}

{%- comment -%}
  SESSION + MANUAL — the shoppable park session (hotspots link real products) beside a
  MANUAL window whose Ride / Care / Build tabs each hold an editable text block.
{%- endcomment -%}
  {% block 'frame', id: 'win-session', window: 'closed', class: 'lg:absolute lg:start-[8%] lg:top-6 lg:w-[min(36%,520px)]', inner_class: 'flex flex-col' %}
      <div class="panel-header">
        {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'home.os.session_title' | t }}{% endblock %}
        {% block 'text', tag: 'span', variant: 'type-data-sm', class: 'uppercase text-ink-invert' %}{{ 'home.field.riders_caption' | t }}{% endblock %}
      </div>
      <div class="relative aspect-[4/3] overflow-hidden [container-type:size] lg:aspect-auto lg:min-h-[28rem] lg:flex-1">
        {% block 'image', image: field_riders_image, class: 'lg:absolute lg:inset-0', sizes: '(min-width: 1024px) 40vw, 100vw', attributes: 'loading="lazy"', alt: riders_alt %}{% endblock %}
        {% render 'hud-brackets' %}
        {%- comment -%}
          The square art is object-cover cropped by this frame, so hotspots sit on a centred
          square layer sized max(frame width, frame height); percent coordinates then match
          the art exactly at every crop. Products bind here so the editor picker rewrites the handle.
        {%- endcomment -%}
        <div class="pointer-events-none absolute start-1/2 top-1/2 aspect-square w-[max(100cqw,100cqh)] -translate-x-1/2 -translate-y-1/2 rtl:translate-x-1/2 *:pointer-events-auto">
          {% block 'hotspot', index: '01', x: 77, y: 35, product: all_products['demo-product'] %}
            {% block 'text', tag: 'span', variant: 'type-heading-sm', class: 'text-on-surface' %}{{ 'home.field.hotspot_1_title' | t }}{% endblock %}
            {% block 'text', tag: 'span', variant: 'type-body-sm', class: 'text-ink-200' %}{{ 'home.field.hotspot_1_body' | t }}{% endblock %}
          {% endblock %}
          {% block 'hotspot', index: '02', x: 55, y: 53, product: all_products['heavyweight-cotton-tee'] %}
            {% block 'text', tag: 'span', variant: 'type-heading-sm', class: 'text-on-surface' %}{{ 'home.field.hotspot_2_title' | t }}{% endblock %}
            {% block 'text', tag: 'span', variant: 'type-body-sm', class: 'text-ink-200' %}{{ 'home.field.hotspot_2_body' | t }}{% endblock %}
          {% endblock %}
          {% block 'hotspot', index: '03', x: 48, y: 37, product: all_products['canvas-tote-bag'] %}
            {% block 'text', tag: 'span', variant: 'type-heading-sm', class: 'text-on-surface' %}{{ 'home.field.hotspot_3_title' | t }}{% endblock %}
            {% block 'text', tag: 'span', variant: 'type-body-sm', class: 'text-ink-200' %}{{ 'home.field.hotspot_3_body' | t }}{% endblock %}
          {% endblock %}
        </div>
      </div>
  {% endblock %}

  {% block 'frame', id: 'win-manual', window: 'closed', class: 'lg:absolute lg:start-[38%] lg:top-[100px] lg:w-[min(36%,520px)]', inner_class: 'flex flex-col' %}
      <div class="panel-header">
        {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'home.os.manual_title' | t }}{% endblock %}
      </div>
      <div class="flex flex-1 flex-col gap-6 p-4 md:p-8">
        {% block 'text', tag: 'p', variant: 'type-title' %}{{ 'home.os.manual_heading' | t }}{% endblock %}
        <div class="grid-tabs mt-auto" role="group" aria-label="{{ 'home.os.manual_title' | t | escape }}">
          <input type="radio" name="home-manual-tabs" id="home-manual-tab-1" checked>
          <label for="home-manual-tab-1" class="grid-tab type-overline">{% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'home.os.tab_1' | t }}{% endblock %}</label>
          <input type="radio" name="home-manual-tabs" id="home-manual-tab-2">
          <label for="home-manual-tab-2" class="grid-tab type-overline">{% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'home.os.tab_2' | t }}{% endblock %}</label>
          <input type="radio" name="home-manual-tabs" id="home-manual-tab-3">
          <label for="home-manual-tab-3" class="grid-tab type-overline">{% block 'text', tag: 'span', variant: 'type-overline' %}{{ 'home.os.tab_3' | t }}{% endblock %}</label>
          <div class="grid-tab-pane">
            {% block 'text', variant: 'type-body-lg', class: 'max-w-[60ch] text-ink-200' %}{{ 'home.os.tab_1_body' | t }}{% endblock %}
          </div>
          <div class="grid-tab-pane">
            {% block 'text', variant: 'type-body-lg', class: 'max-w-[60ch] text-ink-200' %}{{ 'home.os.tab_2_body' | t }}{% endblock %}
          </div>
          <div class="grid-tab-pane">
            {% block 'text', variant: 'type-body-lg', class: 'max-w-[60ch] text-ink-200' %}{{ 'home.os.tab_3_body' | t }}{% endblock %}
          </div>
        </div>
      </div>
  {% endblock %}

{%- comment -%} DIRECTORY + LOG — the collection index read like a system table, beside a SYSTEM LOG window of editable log lines. {%- endcomment -%}
  {% block 'frame', id: 'win-directory', window: 'closed', class: 'lg:absolute lg:start-[18%] lg:top-10 lg:w-[min(44%,640px)]', inner_class: 'flex flex-col' %}
