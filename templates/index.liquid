    </div>
    <div class="relative aspect-[2/3]">
      {% block 'image', image: ridge_image, class: 'absolute inset-0', sizes: '(min-width: 1440px) 570px, (min-width: 1024px) 40vw, (min-width: 750px) calc(100vw - 48px), calc(100vw - 32px)', attributes: 'loading="lazy"', alt: ridge_alt %}{% endblock %}
      {% render 'hud-brackets' %}
      <div class="hud-reticle" style="--x: 37%; --y: 20%; --w: 21%; --h: 16%;">
        {% render 'hud-brackets', class: 'hud-brackets-accent !inset-0' %}
