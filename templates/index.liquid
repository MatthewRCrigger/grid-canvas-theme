    {% endblock %}
    {% block 'desktop-icon', icon: 'image', window: 'win-scan' %}
      {% block 'text', tag: 'span', variant: 'type-data' %}{{ 'os.icon_scan' | t }}{% endblock %}
    {% endblock %}
    {% block 'desktop-icon', icon: 'file', window: 'win-readme' %}
      {% block 'text', tag: 'span', variant: 'type-data' %}{{ 'os.icon_readme' | t }}{% endblock %}
    {% endblock %}
    {% block 'desktop-icon', icon: 'image', window: 'win-session' %}
      {% block 'text', tag: 'span', variant: 'type-data' %}{{ 'os.icon_session' | t }}{% endblock %}
    {% endblock %}
