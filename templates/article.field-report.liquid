<script type="application/ld+json">{{ article | structured_data }}</script>

{%- comment -%}
  FIELD REPORT (article.field-report): a long-form ride log. The entry is the focused document
  window; beside it a sticky LOG.META pane (date, rider, read time, tags) and a GEAR.LOADOUT pane
  of real products from the Hydrogen collection (falls back to all products). Assign this
  template to a blog post under Theme template in the post editor.
{%- endcomment -%}
{% block 'container', class: 'os-stage' %}
  {%- liquid
    assign article_date = article.published_at | date: '%Y.%m.%d'
    assign article_datetime = article.published_at | date: '%Y-%m-%d'
    assign escaped_author = article.author | escape
    assign report_words = article.content | strip_html | split: ' ' | size
    assign report_minutes = report_words | plus: 199 | divided_by: 200 | at_least: 1
    assign gear_collection = collections['hydrogen']
    if gear_collection == blank or gear_collection.products_count == 0
      assign gear_collection = collections['all']
    endif
  -%}
  {%- comment -%} Reading progress: a 2px cyan line under the menu bar, the Log.meta meter and the status bar percentage. {%- endcomment -%}
  <s-read-progress target="report-body" class="contents">
    <div class="os-read-bar" data-read-progress aria-hidden="true"></div>
  </s-read-progress>
  <article class="os-stage-inner">
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
      {% block 'frame', window: 'page', class: 'os-page', inner_class: 'flex flex-col' %}
        <div class="panel-header os-page-bar">
          <span class="truncate">{{ 'blog.report_window' | t }} // {{ article.title | escape }}</span>
          <span class="os-page-meta"><time datetime="{{ article_datetime }}">{{ article_date }}</time></span>
        </div>
        <header class="border-b border-line-400 px-4 py-8 md:px-10 md:py-12">
          <a href="{{ blog.url }}" class="type-overline mb-6 inline-flex min-h-touch-target items-center gap-2 text-info no-underline motion-safe:transition-colors hover:text-on-surface">
            <span class="inline-flex size-4 items-center justify-center rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
            {{- 'blog.back_to_blog' | t -}}
          </a>
          {% block 'text', tag: 'span', variant: 'type-overline', class: 'mb-3 block text-ink-300' %}{{ 'blog.field_overline' | t }}{% endblock %}
          {% block 'text', tag: 'h1', variant: 'type-title', class: 'max-w-full break-words text-on-surface' %}{{ article.title | escape }}{% endblock %}
          {%- if article.excerpt != blank -%}
            <div class="type-body-lg mt-6 max-w-[60ch] text-ink-200">{{ article.excerpt | strip_html | escape }}</div>
          {%- endif -%}
        </header>

        <div id="report-body" class="px-4 py-8 md:px-10 md:py-10">
          {% if article.image %}
            <div class="mb-10 overflow-hidden border border-line-400 bg-panel">
              {%- assign article_image_alt = article.image.alt | default: article.title -%}
              {%- comment -%} The `sizes` kwarg is mirrored by the article LCP preload imagesizes in snippets/lcp-preload.liquid — keep both byte-identical. {%- endcomment -%}
              {% block 'image', image: article.image, sizes: '(min-width: 1008px) 960px, calc(100vw - 48px)', attributes: 'loading="eager" fetchpriority="high"', alt: article_image_alt, aspect_ratio: 'aspect-landscape' %}{% endblock %}
            </div>
          {% endif %}
          {%- if article.content != blank -%}
            {% block 'richtext', text: article.content, class: 'type-body max-w-[68ch] [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-heading [&_h2]:text-[22px] [&_h2]:uppercase [&_h2]:tracking-[0.12em] [&_h2]:text-on-surface [&_blockquote]:my-8 [&_blockquote]:border-s-2 [&_blockquote]:border-info [&_blockquote]:ps-5 [&_blockquote]:text-on-surface' %}{% endblock %}
          {%- endif -%}
        </div>
        <p class="os-page-status mt-auto">
          <span>{{ 'blog.read_minutes' | t: count: report_minutes }}</span>
          <span class="os-read-meter os-read-meter-sm" data-read-progress aria-hidden="true"></span>
        </p>
      {% endblock %}

      <div class="flex flex-col gap-3 lg:sticky lg:top-[calc(var(--os-menubar-h)+16px)]">
        {% block 'frame', window: 'pane' %}
          <div class="panel-header os-pane-bar">
            {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'blog.meta_title' | t }}{% endblock %}
          </div>
          <dl class="px-4">
            <div class="flex items-baseline gap-3 border-b border-line-400 py-3">
              <dt class="type-body-sm text-ink-300">{{ 'blog.meta_date' | t }}</dt>
              <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
              <dd class="type-data text-on-surface"><time datetime="{{ article_datetime }}">{{ article_date }}</time></dd>
            </div>
            {%- if article.author != blank -%}
              <div class="flex items-baseline gap-3 border-b border-line-400 py-3">
                <dt class="type-body-sm text-ink-300">{{ 'blog.meta_author' | t }}</dt>
                <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
                <dd class="type-data uppercase text-on-surface">{{ escaped_author }}</dd>
              </div>
            {%- endif -%}
            <div class="flex items-baseline gap-3 py-3">
              <dt class="type-body-sm text-ink-300">{{ 'blog.meta_read' | t }}</dt>
              <span class="flex-1 translate-y-[-3px] border-b border-dotted border-line-300" aria-hidden="true"></span>
              <dd class="type-data uppercase text-on-surface">{{ 'blog.read_minutes' | t: count: report_minutes }}</dd>
            </div>
            <div class="flex items-center gap-3 border-t border-line-400 py-3">
              <dt class="type-body-sm text-ink-300">{{ 'blog.meta_progress' | t }}</dt>
              <dd class="os-read-meter" data-read-progress role="progressbar" aria-label="{{ 'blog.meta_progress' | t | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></dd>
            </div>
            {%- if article.tags.size > 0 -%}
              <div class="border-t border-line-400 py-3">
                <dt class="type-body-sm mb-2 text-ink-300">{{ 'blog.meta_tags' | t }}</dt>
                <dd class="flex flex-wrap gap-2">
                  {%- for tag in article.tags -%}
                    <a class="badge badge-info no-underline" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>
                  {%- endfor -%}
                </dd>
              </div>
            {%- endif -%}
          </dl>
        {% endblock %}

        {%- if gear_collection.products_count > 0 -%}
          {% block 'frame', window: 'pane' %}
            <div class="panel-header os-pane-bar">
              {% block 'text', tag: 'h2', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'blog.gear_title' | t }}{% endblock %}
              <span class="os-page-meta">{{ gear_collection.title | escape }}</span>
            </div>
            <ul role="list" class="divide-y divide-line-400">
              {%- for gear in gear_collection.products limit: 3 -%}
                <li>
                  <a href="{{ gear.url }}" class="group flex items-center gap-3 p-3 no-underline">
                    <span class="block size-16 shrink-0 overflow-hidden border border-line-400 bg-surface group-hover:border-line-100">
                      {% block 'image', fallback_image: gear.featured_image, aspect_ratio: 'aspect-square', sizes: '64px', widths: '64,128', attributes: 'loading="lazy"', alt: gear.title %}{% endblock %}
                    </span>
                    <span class="flex min-w-0 flex-col gap-1">
                      <span class="type-heading-sm line-clamp-2 text-on-surface group-hover:text-info">{{ gear.title | escape }}</span>
                      <span class="type-data text-ink-200">{{ gear.price | money }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
            <div class="border-t border-line-400 p-3">
              {% block 'button', url: gear_collection.url, variant: 'button-secondary', class: 'h-11 w-full text-[13px]' %}{{ 'blog.gear_cta' | t }}{% endblock %}
            </div>
          {% endblock %}
        {%- endif -%}
      </div>
    </div>

      {%- comment -%} Comments sit in a GRID panel: hairline rows, mono timestamps, then the form. {%- endcomment -%}
      {% if blog.comments_enabled? %}
        {% block 'frame', window: 'pane', tag: 'section', class: 'mt-6', attributes: 'aria-labelledby="article-comments-title"' %}
            <div class="panel-header os-pane-bar">
              {% block 'text', tag: 'span', variant: 'type-overline-lg', class: 'text-ink-invert' %}{{ 'blog.comments_panel' | t }}{% endblock %}
              <span class="type-data-sm uppercase text-ink-invert" id="article-comments-title">{{ 'blog.comments_count' | t: count: article.comments_count }}</span>
            </div>
            <div class="p-4 md:p-6">
              {% paginate article.comments by 10 %}
                {% for comment in article.comments %}
                  <div class="py-5{% unless forloop.last %} border-b border-line-400{% endunless %}">
                    <div class="mb-2 flex flex-wrap items-center gap-3">
                      {% block 'text', variant: 'type-heading-sm', class: 'text-on-surface' %}{{ comment.author | escape }}{% endblock %}
                      <time datetime="{{ comment.created_at | date: '%Y-%m-%dT%H:%M:%S%z' }}" class="type-data-sm text-ink-300">
                        {{- comment.created_at | date: '%Y.%m.%d' -}}
                      </time>
                    </div>
                    <div class="type-body text-ink-200">{{ comment.content | escape | newline_to_br }}</div>
                  </div>
                {% endfor %}

                {% block 'pagination', paginate: paginate %}{% endblock %}
              {% endpaginate %}

        {% form 'new_comment', article %}
          {%- if form.errors -%}
            <div role="alert" class="mb-4 flex items-start gap-3 border border-critical p-4 text-on-surface">
              <div class="flex-1">
                <p class="type-overline mb-2 text-critical">{{ 'forms.form_errors_title' | t }}</p>
                <ul class="type-body-sm list-disc ps-4">
                  {% for field in form.errors %}
                    <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            {%- for field in form.errors -%}
              {%- capture field_error_message -%}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{%- endcapture -%}
              {%- case field -%}
                {%- when 'author' -%}
                  {%- assign comment_name_error = field_error_message -%}
                {%- when 'email' -%}
                  {%- assign comment_email_error = field_error_message -%}
                {%- when 'body' -%}
                  {%- assign comment_body_error = field_error_message -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- endif -%}

          <div class="mt-8 flex max-w-md flex-col gap-4">
            {% block 'text', tag: 'h3', variant: 'type-overline-lg', class: 'text-on-surface' %}{{ 'blog.comment_form_title' | t }}{% endblock %}

            {%- assign comment_name_label = 'blog.comment_form_name' | t -%}
            {%- assign comment_email_label = 'blog.comment_form_email' | t -%}
            {%- assign comment_body_label = 'blog.comment_form_body' | t -%}

            {%- comment -%} Comment form repopulation with form.author and form.email {%- endcomment -%}
            <div>
              <label for="comment-name" class="type-overline mb-2 block text-ink-300">
                {{- comment_name_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <input
                type="text"
                name="comment[author]"
                id="comment-name"
                class="w-full"
                {%- if form.author != blank %} value="{{ form.author | escape }}"{% endif %}
                autocomplete="name"
                required
                aria-required="true"
                {%- if comment_name_error != blank %} aria-invalid="true" aria-describedby="comment-name-error"{% endif %}
              >
              {%- if comment_name_error != blank -%}
                <p id="comment-name-error" class="text-[12px] text-critical" role="alert">{{ comment_name_error | escape }}</p>
              {%- endif -%}
            </div>
            <div>
              <label for="comment-email" class="type-overline mb-2 block text-ink-300">
                {{- comment_email_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <input
                type="email"
                name="comment[email]"
                id="comment-email"
                class="w-full"
                {%- if form.email != blank %} value="{{ form.email | escape }}"{% endif %}
                autocomplete="email"
                required
                aria-required="true"
                {%- if comment_email_error != blank %} aria-invalid="true" aria-describedby="comment-email-error"{% endif %}
              >
              {%- if comment_email_error != blank -%}
                <p id="comment-email-error" class="text-[12px] text-critical" role="alert">{{ comment_email_error | escape }}</p>
              {%- endif -%}
            </div>
            <div>
              <label for="comment-body" class="type-overline mb-2 block text-ink-300">
                {{- comment_body_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <textarea
                name="comment[body]"
                id="comment-body"
                rows="4"
                class="w-full"
                required
                aria-required="true"
                {%- if comment_body_error != blank %} aria-invalid="true" aria-describedby="comment-body-error"{% endif %}
              >
                {%- if form.body != blank %}{{ form.body | escape }}{% endif -%}
              </textarea>
              {%- if comment_body_error != blank -%}
                <p id="comment-body-error" class="text-[12px] text-critical" role="alert">{{ comment_body_error | escape }}</p>
              {%- endif -%}
            </div>

            {% block 'button', type: 'submit', variant: 'button-primary', class: 'h-11 self-start px-5 text-[13px]' %}{{- 'blog.comment_form_submit' | t -}}{% endblock %}
          </div>
        {% endform %}
            </div>
        {% endblock %}
      {% endif %}
  </article>
{% endblock %}
<script type="module" src="{{ 's-read-progress.js' | asset_url }}"></script>
