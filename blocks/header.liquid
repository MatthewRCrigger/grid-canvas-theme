{% doc %}
  Renders the storefront's semantic `<header>` wrapper as a dedicated Canvas
  selection surface. It mirrors the container block's background and padding
  controls without exposing a background image. Body content is composed via
  `{{ content }}`.

  @param {string} [class] - Tailwind utilities other than vertical padding; the padding setting owns `py-*`, `pt-*`, and `pb-*`.
  @param {string} [attributes] - Additional HTML attributes passed through to the header.

  Settings: `scroll_behavior` (`static`, `sticky`, `sticky-shrink`) pins the header to the top; `sticky-shrink` also sets `data-scrolled` once the page scrolls so callers can shrink the logo and row with `group-data-[scrolled]/header:`; `logo_position` (`logo-left`/`logo-center`) is written to `data-layout` for `group-data-[layout=logo-center]/header:` utilities.

  @category layout
  @renders header

  @example
  {% block 'header', class: 'w-full' %}
    <nav aria-label="Main navigation">...</nav>
  {% endblock %}
{% enddoc %}

{%- liquid
  # Header scroll behaviour: static, sticky, or sticky with the logo shrinking once the page scrolls.
  assign scroll_behavior = scroll_behavior | default: 'static'
  assign sticky = false
  assign shrink_logo = false
  if scroll_behavior == 'sticky' or scroll_behavior == 'sticky-shrink'
    assign sticky = true
  endif
  if scroll_behavior == 'sticky-shrink'
    assign shrink_logo = true
  endif
  assign logo_position = logo_position | default: 'logo-left'
  assign composed_class = 'group/header ' | append: padding
  if sticky
    assign composed_class = composed_class | append: ' sticky top-0 z-40'
  endif
  if class != blank
    assign composed_class = composed_class | append: ' ' | append: class
  endif
  assign composed_class = composed_class | strip
-%}

<header class="{{ composed_class }}" data-layout="{{ logo_position | escape }}"{% if attributes != blank %} {{ attributes }}{% endif %}{% if background != blank %} style="background-color: {{ background }}"{% endif %}>
  {{ content }}
  {%- if sticky and shrink_logo -%}
    {%- comment -%} Sets data-scrolled on this header past the top of the page; layout utilities read it with group-data-[scrolled]/header. {%- endcomment -%}
    <s-sticky-header hidden></s-sticky-header>
    <script type="module" src="{{ 's-sticky-header.js' | asset_url }}"></script>
  {%- endif -%}
</header>

{% schema %}
  {
    "name": "t:blocks.header",
    "settings": [
      {
        "type": "color",
        "id": "background",
        "label": "t:general.background"
      },
      {
        "type": "select",
        "id": "padding",
        "label": "t:blocks.container_settings.padding",
        "default": "",
        "options": [
          { "value": "", "label": "t:general.none" },
          { "value": "py-8", "label": "t:blocks.container_settings.padding_small" },
          { "value": "py-16", "label": "t:blocks.container_settings.padding_medium" },
          { "value": "py-24", "label": "t:blocks.container_settings.padding_large" },
          { "value": "py-32", "label": "t:blocks.container_settings.padding_extra_large" }
        ]
      },
      {
        "type": "select",
        "id": "scroll_behavior",
        "label": "t:blocks.header_settings.scroll_behavior",
        "info": "t:blocks.header_settings.scroll_behavior_info",
        "default": "static",
        "options": [
          { "value": "static", "label": "t:blocks.header_settings.scroll_static" },
          { "value": "sticky", "label": "t:blocks.header_settings.scroll_sticky" },
          { "value": "sticky-shrink", "label": "t:blocks.header_settings.scroll_sticky_shrink" }
        ]
      },
      {
        "type": "select",
        "id": "logo_position",
        "label": "t:blocks.header_settings.logo_position",
        "default": "logo-left",
        "options": [
          { "value": "logo-left", "label": "t:blocks.header_settings.logo_position_left" },
          { "value": "logo-center", "label": "t:blocks.header_settings.logo_position_center" }
        ]
      }
    ]
  }
{% endschema %}
