{% doc %}
  GRID OS glyphs for the dock and desktop icons: 1.5px wireframe line art on a 24-unit grid.
  Strokes do not scale, so the line stays a hairline at dock (24px) and desktop (48px) sizes.

  @param {string} name - finder, bag, folder, file, image, board, search, compare, cart, journal, terminal, mail, list, icons, alert, lock, info, grid
  @param {string} [class] - Size and color utilities on the svg.

  @example
  {% render 'os-icon', name: 'folder', class: 'size-12 text-accent' %}
{% enddoc %}

<svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'bag' -%}
      <path vector-effect="non-scaling-stroke" d="M4.5 8h15l-1.2 12.5H5.7z"/><path vector-effect="non-scaling-stroke" d="M9 10.5V6.5a3 3 0 0 1 6 0v4"/>
    {%- when 'folder' -%}
      <path vector-effect="non-scaling-stroke" d="M2.5 5h7l2 2.5h10v12h-19z"/><path vector-effect="non-scaling-stroke" d="M2.5 10h19"/>
    {%- when 'file' -%}
      <path vector-effect="non-scaling-stroke" d="M5.5 2.5h9l4 4v15h-13z"/><path vector-effect="non-scaling-stroke" d="M14.5 2.5v4h4M8.5 11h7M8.5 14h7M8.5 17h4"/>
    {%- when 'image' -%}
      <path vector-effect="non-scaling-stroke" d="M2.5 4.5h19v15h-19z"/><path vector-effect="non-scaling-stroke" d="M2.5 16l5.5-5.5 4.5 4.5 3-3 6 6"/><path vector-effect="non-scaling-stroke" d="M15.5 8.5h2v2h-2z"/>
    {%- when 'board' -%}
      <path vector-effect="non-scaling-stroke" d="M8.2 2.8c1.6-.7 3.3.1 4 1.7l6.6 14c.7 1.6 0 3.4-1.6 4s-3.3-.1-4-1.7L6.6 6.8c-.7-1.6 0-3.4 1.6-4z"/><path vector-effect="non-scaling-stroke" d="M8.5 8.5l3-1.4M12.5 17.1l3-1.4"/>
    {%- when 'search' -%}
      <path vector-effect="non-scaling-stroke" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z"/><path vector-effect="non-scaling-stroke" d="M15.5 15.5l5 5"/>
    {%- when 'compare' -%}
      <path vector-effect="non-scaling-stroke" d="M2.5 4.5h8v15h-8zM13.5 4.5h8v15h-8z"/><path vector-effect="non-scaling-stroke" d="M5 9h3M16 9h3M5 12h3M16 12h3"/>
    {%- when 'cart' -%}
      <path vector-effect="non-scaling-stroke" d="M4 8h16l-1.3 12.5H5.3z"/><path vector-effect="non-scaling-stroke" d="M8.5 11V7a3.5 3.5 0 0 1 7 0v4"/>
    {%- when 'journal' -%}
      <path vector-effect="non-scaling-stroke" d="M5 3.5h14v17H5z"/><path vector-effect="non-scaling-stroke" d="M8.5 3.5v17M11.5 8h4.5M11.5 11h4.5"/>
    {%- when 'terminal' -%}
      <path vector-effect="non-scaling-stroke" d="M2.5 4.5h19v15h-19z"/><path vector-effect="non-scaling-stroke" d="M6.5 9.5l3 2.5-3 2.5M12 15h5"/>
    {%- when 'mail' -%}
      <path vector-effect="non-scaling-stroke" d="M2.5 5.5h19v13h-19z"/><path vector-effect="non-scaling-stroke" d="M2.5 6.5l9.5 7 9.5-7"/>
    {%- when 'list' -%}
      <path vector-effect="non-scaling-stroke" d="M3 5h3v3H3zM3 10.5h3v3H3zM3 16h3v3H3z"/><path vector-effect="non-scaling-stroke" d="M9 6.5h12M9 12h12M9 17.5h12"/>
    {%- when 'icons' -%}
      <path vector-effect="non-scaling-stroke" d="M3.5 3.5h7v7h-7zM13.5 3.5h7v7h-7zM3.5 13.5h7v7h-7zM13.5 13.5h7v7h-7z"/>
    {%- when 'alert' -%}
      <path vector-effect="non-scaling-stroke" d="M12 3l9.5 17h-19z"/><path vector-effect="non-scaling-stroke" d="M12 9.5v5M12 16.5v1.5"/>
    {%- when 'lock' -%}
      <path vector-effect="non-scaling-stroke" d="M5 10.5h14v10H5z"/><path vector-effect="non-scaling-stroke" d="M8 10.5V7a4 4 0 0 1 8 0v3.5M12 14v3"/>
    {%- when 'info' -%}
      <path vector-effect="non-scaling-stroke" d="M3 3h18v18H3z"/><path vector-effect="non-scaling-stroke" d="M12 10.5V17M12 7v1.5"/>
    {%- else -%}
      {%- comment -%} finder / grid: the GRID system mark, a window split into four. {%- endcomment -%}
      <path vector-effect="non-scaling-stroke" d="M3 3h18v18H3z"/><path vector-effect="non-scaling-stroke" d="M12 3v18M3 12h18"/>
  {%- endcase -%}
</svg>
