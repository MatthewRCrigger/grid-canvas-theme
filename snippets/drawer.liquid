{% doc %}
  Renders a drawer panel using a native `<dialog>` element. Opens via
  Invoker Commands (`commandfor`/`command="show-modal"` on trigger buttons),
  closes via `command="close"`, Escape key, or backdrop click. CSS handles
  slide animations via `@starting-style` and `transition-behavior: allow-discrete`.
  The `<s-dialog>` Web Component handles backdrop-click-to-close and
  responsive breakpoint auto-close.

  The drawer uses a flex-col layout: the header and footer are pinned (`shrink-0`),
  and the body scrolls independently (`flex-1 overflow-y-auto`). The footer region
  is only rendered when a `footer` capture is provided. Pass a `header` capture to
  completely replace the built-in title/close-button header with custom HTML.

  @param {string} id - Unique HTML id applied to the `<dialog>` element. @required
  @param {string} content - HTML or text rendered in the scrollable body of the drawer. @required
  @param {string} [position] - Edge from which the drawer slides in. Default: 'right'. One of: 'left'|'right'|'bottom'.
  @param {string} [title] - Optional heading rendered in the drawer header alongside the close button
  @param {string} [close_button] - Unused: the drawer is a GRID OS pop-up window (snippets/os-dialog-window.liquid) whose close light closes it. Kept so older callers still render.
  @param {string} [header] - Custom title bar (`<div class="panel-header">…</div>`) replacing the built-in one; the window seats its lights at its start.
  @param {string} [footer] - HTML content pinned to the bottom of the drawer
  @param {string} [class] - Additional CSS classes to append to the `<dialog>` element
  @param {string} [attributes] - Additional HTML attributes passed through to the `<dialog>` element. When a custom `header` is provided, include `aria-labelledby` pointing to a heading ID in the custom header to provide an accessible name.
  @param {boolean} [close_on_navigate] - Close the drawer when an `<a>` inside it is clicked (for client-side navigation)

  @category interactive
  @renders s-dialog

  @example Default header with title and close button
  {% capture drawer_content %}
    <p class="text-sm">Cart items go here.</p>
  {% endcapture %}
  {%- assign close_label = 'general.close' | t -%}
  {%- capture drawer_close_attrs -%}aria-label="{{ close_label | escape }}"{%- endcapture -%}
  {% capture drawer_close_button %}
    {% block 'button', commandfor: 'example-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: drawer_close_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
  {% endcapture %}
  {% render 'drawer', id: 'example-drawer', title: 'Your cart', content: drawer_content, close_button: drawer_close_button %}

  @example No-title header with close button only
  {% capture simple_content %}
    <p class="text-sm">Drawer body content.</p>
  {% endcapture %}
  {%- assign close_text = 'general.close' | t -%}
  {%- capture simple_close_attrs -%}aria-label="{{ close_text | escape }}"{%- endcapture -%}
  {% capture simple_close_button %}
    {% block 'button', commandfor: 'simple-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: simple_close_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
  {% endcapture %}
  {% render 'drawer', id: 'simple-drawer', content: simple_content, close_button: simple_close_button %}

  @example Custom header (caller owns close button)
  {% capture custom_header %}
    <div class="flex items-center justify-between p-4 border-b border-border shrink-0">
      <h2 id="cart-drawer-composed-title" class="text-lg font-medium text-on-surface">Your cart</h2>
      {% capture custom_close_attrs %}aria-label="{{ 'general.close' | t | escape }}"{% endcapture %}
      {% block 'button', commandfor: 'cart-drawer-composed', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: custom_close_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
    </div>
  {% endcapture %}
  {% capture custom_footer %}
    <button type="button" class="w-full px-4 py-2 text-sm bg-interactive text-interactive-text rounded">
      Checkout &mdash; $49.99
    </button>
  {% endcapture %}
  {% capture drawer_content %}
    <ul class="divide-y divide-border">
      <li class="py-3">Cart item 1</li>
      <li class="py-3">Cart item 2</li>
    </ul>
  {% endcapture %}
  {% render 'drawer', id: 'cart-drawer-composed', position: 'right', content: drawer_content, header: custom_header, footer: custom_footer, attributes: 'aria-labelledby="cart-drawer-composed-title"' %}
{% enddoc %}

{%- liquid
  assign position = position

  case position
    when 'left'
      # GRID window (config/styles.css): full-page cover on phones, framed floating panel from 48rem.
      assign dialog_class = 'overlay-panel grid-window grid-window-start'
    when 'bottom'
      # Zero-specificity defaults preserve caller overrides while content stays clear of the home indicator and side notches.
      assign dialog_class = 'overlay-panel [--panel-closed-transform:translateY(100%)] [:where(&)]:fixed [:where(&)]:inset-bs-auto [:where(&)]:inset-be-0 [:where(&)]:inset-x-0 [:where(&)]:w-full [:where(&)]:max-h-dialog-max-height [:where(&)]:pb-(--safe-area-inset-bottom) [:where(&)]:ps-(--safe-area-inset-inline-start) [:where(&)]:pe-(--safe-area-inset-inline-end) border-t border-line-100 text-on-surface'
    else
      # Same GRID window, anchored to the inline end.
      assign dialog_class = 'overlay-panel grid-window'
  endcase

  if class != blank
    assign dialog_class = dialog_class | append: ' ' | append: class
  endif
-%}

{%- comment -%} `<s-dialog>` wraps native `<dialog>` to add close-on-backdrop-click and responsive auto-close (e.g. on viewport resize past a breakpoint); the native element provides focus-trap and `::backdrop`. Do not unwrap to a bare `<dialog>`. {%- endcomment -%}
<s-dialog {% if close_on_navigate %} close-on-navigate{% endif %}>
<dialog id="{{ id }}" class="{{ dialog_class }}"{% if title != blank %} aria-labelledby="{{ id }}-title"{% elsif header == blank %} aria-label="{{ 'general.drawer' | t }}"{% endif %}{% if attributes != blank %} {{ attributes }}{% endif %}>
  {%- capture drawer_window -%}
    {%- if header != blank -%}
      {{ header }}
    {%- elsif title != blank -%}
      <div class="panel-header">
        <h2 id="{{ id }}-title" class="type-overline-lg flex-1 truncate text-ink-invert">{{ title | escape }}</h2>
      </div>
    {%- else -%}
      <div class="panel-header"></div>
    {%- endif -%}
    <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4 md:p-5">
      {{ content }}
    </div>
    {%- if footer != blank -%}
      <div class="shrink-0 border-t border-line-300 p-4 md:p-5">
        {{ footer }}
      </div>
    {%- endif -%}
  {%- endcapture -%}
  {%- assign drawer_window_id = id | append: '-window' -%}
  {% render 'os-dialog-window', id: drawer_window_id, content: drawer_window %}
</dialog>
</s-dialog>

<script type="module" src="{{ 's-dialog.js' | asset_url }}"></script>
