{% doc %}
  The three window controls of every GRID OS window (close, minimize, zoom) as square signal
  lights at the start of the title bar. Each button commands the s-window with the given id;
  what the command does depends on the window's role (see s-window.js). Minimize and zoom
  appear from 64rem. Below that a page or desktop window shows close at full touch size, and a
  pane shows no controls (a pane has no dock to minimize into on small screens).

  @param {string} id - Id of the s-window these controls command.
  @param {string} [role] - The frame's Window value: page, pane, open or closed.

  @example
  {% render 'os-window-controls', id: 'win-inventory', role: 'open' %}
{% enddoc %}

{%- liquid
  assign close_label = 'os.window_close' | t
  if role == 'page'
    assign close_label = 'os.page_close' | t
  endif
-%}

<div class="os-window-controls" data-window-controls>
  <button type="button" class="os-light os-light-close" commandfor="{{ id }}" command="--close" aria-label="{{ close_label | escape }}">
    <span class="os-light-dot" aria-hidden="true"><svg viewBox="0 0 8 8"><path d="M1.5 1.5l5 5M6.5 1.5l-5 5"/></svg></span>
  </button>
  <button type="button" class="os-light os-light-min" commandfor="{{ id }}" command="--minimize" aria-label="{{ 'os.window_minimize' | t | escape }}">
    <span class="os-light-dot" aria-hidden="true"><svg viewBox="0 0 8 8"><path d="M1.5 4h5"/></svg></span>
  </button>
  <button type="button" class="os-light os-light-zoom" commandfor="{{ id }}" command="--zoom" aria-label="{{ 'os.window_zoom' | t | escape }}">
    <span class="os-light-dot" aria-hidden="true"><svg viewBox="0 0 8 8"><path d="M4 1.5v5M1.5 4h5"/></svg></span>
  </button>
</div>
