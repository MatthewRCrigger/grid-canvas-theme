{% doc %}
  Renders a single cart line item with quantity controls and remove button.
  Supports full (cart page) and compact (cart drawer) layouts. The caller owns
  independently editable image, unit-price and remove-button blocks and passes
  their rendered captures; this utility owns native row/quantity/discount markup.

  @param {line_item} item - Shopify cart line item object. @required
  @param {string} cart_id - The id of the parent `<s-cart>` element for commandfor targeting. @required
  @param {boolean} [compact] - When true, renders the compact two-row stacked layout for drawers. Default: false.
  @param {string} [media] - Caller-rendered image block, placed in the existing media frame when item.image exists.
  @param {string} unit_price - Caller-rendered price block for item.original_price. @required
  @param {string} remove_button - Caller-rendered remove button targeting cart_id and the item's line key. @required
  @param {string} [class] - Additional CSS classes to append to the root element.
  @param {string} [attributes] - Additional HTML attributes passed through to the root element.

  @category commerce
  @renders div

  @example
  {% render 'cart-line-item', item: item, cart_id: 'cart', compact: false, media: line_media, unit_price: line_unit_price, remove_button: line_remove_button %}
  {% render 'cart-line-item', item: item, cart_id: 'cart-drawer-items', compact: true, media: line_media, unit_price: line_unit_price, remove_button: line_remove_button %}
{% enddoc %}

{%- liquid
  assign compact = compact | default: false
  assign safe_title = item.product.title | escape
  assign qty_min = item.variant.quantity_rule.min | default: 1
  assign qty_max = item.variant.quantity_rule.max
  assign qty_step = item.variant.quantity_rule.increment | default: 1
  assign cart_transition_scope = cart_id | handleize
  assign line_transition_key = item.key | handleize
  assign line_transition_name = 'cart-item-' | append: item.variant_id | append: '-' | append: cart_transition_scope | append: '-' | append: line_transition_key
-%}

{%- comment -%} commandfor/command attributes on the stepper target the parent <s-cart> element via the command pattern —
  do not replace with onclick handlers or the quantity controls will stop working. See assets/s-cart.js class JSDoc. {%- endcomment -%}
{%- capture quantity_stepper -%}
  <div class="inline-flex items-center border border-line-300 bg-surface-secondary">
    <button type="button" commandfor="{{ cart_id }}" command="--update-quantity" data-delta="-{{ qty_step }}" data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key }}" data-qty-min="{{ qty_min }}"{% if qty_max != blank %} data-qty-max="{{ qty_max }}"{% endif %} data-qty-step="{{ qty_step }}" class="inline-flex size-touch-target cursor-pointer items-center justify-center text-ink-200 motion-safe:transition-colors hover:bg-hover hover:text-on-surface" aria-label="{{ 'product.quantity_decrease' | t: title: safe_title }}">
      <span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
    </button>
    <input type="number" inputmode="numeric" value="{{ item.quantity }}" min="{{ qty_min }}"{% if qty_max != blank %} max="{{ qty_max }}"{% endif %} step="{{ qty_step }}" data-quantity-display data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key }}" data-qty-min="{{ qty_min }}"{% if qty_max != blank %} data-qty-max="{{ qty_max }}"{% endif %} data-qty-step="{{ qty_step }}" aria-label="{{ 'product.quantity_input' | t: title: safe_title }}" class="h-touch-target min-h-0 w-11 rounded-none border-0 border-x border-line-400 bg-transparent px-1 py-0 text-center font-mono text-[13px] text-on-surface [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none">
    <button type="button" commandfor="{{ cart_id }}" command="--update-quantity" data-delta="{{ qty_step }}" data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key }}" data-qty-min="{{ qty_min }}"{% if qty_max != blank %} data-qty-max="{{ qty_max }}"{% endif %} data-qty-step="{{ qty_step }}" class="inline-flex size-touch-target cursor-pointer items-center justify-center text-ink-200 motion-safe:transition-colors hover:bg-hover hover:text-on-surface" aria-label="{{ 'product.quantity_increase' | t: title: safe_title }}">
      <span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
    </button>
  </div>
{%- endcapture -%}

{%- capture line_discounts -%}
  {% if item.line_level_discount_allocations.size > 0 %}
    <ul class="mt-2 flex flex-col gap-1" aria-label="{{ 'cart.discount_list' | t }}">
      {% for discount in item.line_level_discount_allocations %}
        <li class="flex items-center gap-1.5 font-mono text-[12px] uppercase text-sale">
          <span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true">{{- 'icon-tag.svg' | inline_asset_content -}}</span>
          {%- assign formatted_amount = discount.amount | money -%}
          <bdi>{{ discount.discount_application.title | escape }}</bdi> <bdi>{{ 'cart.discount_savings' | t: amount: formatted_amount }}</bdi>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{%- endcapture -%}

{%- comment -%} Include variant id for readable selectors and line key/cart id so duplicate rows keep unique view-transition names. {%- endcomment -%}
{%- if compact -%}
  {%- comment -%} Compact layout: two-row stacked for cart drawer {%- endcomment -%}
  <div class="flex gap-3 py-4{% if class != blank %} {{ class }}{% endif %}"{% if attributes != blank %} {{ attributes }}{% endif %} style="view-transition-name: {{ line_transition_name }}">
    {% if item.image %}
      <a href="{{ item.url }}" class="block size-20 md:size-24 shrink-0 overflow-hidden border border-line-400 bg-surface" aria-hidden="true" tabindex="-1">
        {{ media }}
      </a>
    {% endif %}

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <a href="{{ item.url }}" class="type-heading-sm line-clamp-2 text-on-surface no-underline motion-safe:transition-colors hover:text-accent">
            {{ item.product.title | escape }}
          </a>
          {% if item.variant.title != 'Default Title' %}
            <p class="mt-0.5 font-mono text-[12px] uppercase text-ink-300"><bdi>{{ item.variant.title | escape }}</bdi></p>
          {% endif %}
          {{ unit_price }}
        </div>
        <p class="shrink-0 font-mono text-[13px] text-on-surface"><bdi>{{ item.line_price | money }}</bdi></p>
      </div>

      <div class="mt-2 flex items-center gap-2">
        {{ quantity_stepper }}
        {{ remove_button }}
      </div>
      {{ line_discounts }}
    </div>
  </div>
{%- else -%}
  {%- comment -%} Full layout: single-row for cart page. {%- endcomment -%}
  <div class="flex items-start gap-4 py-5 sm:gap-6{% if class != blank %} {{ class }}{% endif %}"{% if attributes != blank %} {{ attributes }}{% endif %} style="view-transition-name: {{ line_transition_name }}">
    {% if item.image %}
      <a href="{{ item.url }}" class="block w-[76px] shrink-0 overflow-hidden border border-line-400 bg-surface sm:w-[104px]" aria-hidden="true" tabindex="-1">
        {{ media }}
      </a>
    {% endif %}

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <a href="{{ item.url }}" class="type-heading-sm text-[16px] text-on-surface no-underline motion-safe:transition-colors hover:text-accent">
            {{ item.product.title | escape }}
          </a>
          {% if item.variant.title != 'Default Title' %}
            <p class="mt-1 font-mono text-[12px] uppercase text-ink-300"><bdi>{{ item.variant.title | escape }}</bdi></p>
          {% endif %}
          {{ unit_price }}
        </div>
        <p class="shrink-0 font-mono text-[15px] text-on-surface"><bdi>{{ item.line_price | money }}</bdi></p>
      </div>

      <div class="mt-4 flex items-center gap-3">
        {{ quantity_stepper }}
        {{ remove_button }}
      </div>
      {{ line_discounts }}
    </div>
  </div>
{%- endif -%}
